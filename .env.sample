# note MCP Server 環境変数
# MVPは環境変数の認証情報を使います。値はコミットしないでください。

# note.com のユーザーID（プロフィールURLの末尾部分）
# 例: https://note.com/imp0820 → imp0820
# 記事URLの生成やユーザー情報の取得に使用
NOTE_USER_ID=your_note_user_id

# 既存のnote.comセッションを使う場合（推奨）
# NOTE_SESSION_V5=your_session_cookie_value
# NOTE_XSRF_TOKEN=your_xsrf_token

# メール/パスワードによる直接ログインを使う場合（任意）
# NOTE_EMAIL=your-email@example.com
# NOTE_PASSWORD=your-password
