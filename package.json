{
  "name": "note-ops",
  "version": "0.1.0",
  "description": "Minimal MCP server for managing note.com drafts and articles",
  "type": "module",
  "main": "build/index.js",
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "setup:win": "powershell -ExecutionPolicy Bypass -File scripts/setup.ps1",
    "build": "tsc",
    "start": "node build/index.js",
    "dev": "npm run build && npm run start",
    "test": "npm run build && node --test test/*.test.mjs",
    "dev:watch": "tsc --watch",
    "capture:session": "node scripts/capture-session-playwright.js",
    "image:insert": "node scripts/final-image-insert.mjs",
    "image:insert:check": "node --check scripts/final-image-insert.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.7.0",
    "@notionhq/client": "^2.2.14",
    "dotenv": "^16.3.1",
    "node-fetch": "^3.3.2",
    "playwright": "^1.56.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.4",
    "prettier": "^3.7.4",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.3"
  }
}
