{
  "name": "note-ops",
  "version": "0.1.0",
  "description": "Minimal MCP server for managing note.com drafts and articles",
  "type": "module",
  "main": "build/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node build/index.js",
    "dev": "npm run build && npm run start",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:live": "npm run build && node test/live-smoke.mjs",
    "dev:watch": "tsc --watch"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "dotenv": "^18.0.9",
    "node-fetch": "^3.3.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
