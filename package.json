{
  "name": "note-ops",
  "version": "0.1.0",
  "description": "Minimal MCP server for managing note.com drafts and articles",
  "type": "module",
  "main": "build/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node build/index.js",
    "dev": "npm run build && npm run start",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:live": "npm run build && node test/live-smoke.mjs",
    "dev:watch": "tsc --watch"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^16.3.1",
    "node-fetch": "^3.3.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.4",
    "prettier": "^3.7.4",
    "typescript": "^5.3.3"
  }
}
